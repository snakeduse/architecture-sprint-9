@startuml open_deposit

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

top to bottom direction

Person_Ext(client, "Клиент банка", "")

System_Boundary(bank, "Банк ''Открытие''") {
    Container(internet_bank, "Интернет-банк", "ASP.NET MVC 4.5 на основе .NET Framework 4.5")
    SystemDb(internet_bank_db, "БД интернет-банка", "MS SQL")
    SystemQueue(queue_new_deposits, "Очередь сообщений для новых заявок на депозиты", "Apache Kafka")
    SystemQueue(queue_approved_deposits, "Очередь сообщений для подтвержденных заявок на депозиты", "Apache Kafka")
    SystemQueue(queue_data, "Очередь сообщений для справочной информации", "Apache Kafka")
    Container(deposits_service, "Микросервис открытия депозитов", "Java Spring Boot")
    SystemDb(deposits_service_db, "База данных микросервиса открытия депозитов", "PostgreSQL")
    SystemDb(abs_db, "База данных автоматизированной банковской системы (АБС)", "Oracle")
    Container(abs, "Автоматизированная банковская система (АБС)", "Delphi")
}

System_Ext(telecomOperator, "Телеком-оператор")

Rel(client, internet_bank, "Подача заявки на открытие депозита", "TLS 1.3")
Rel(internet_bank, queue_new_deposits, "Новая заявка на открытие депозита")
Rel(internet_bank, internet_bank_db, "Данные интернет-банка")
Rel(queue_new_deposits, deposits_service, "Новая заявка на открытие депозита")
Rel(deposits_service, deposits_service_db, "Сохранение новой заявки на открытие депозита")
Rel(deposits_service, telecomOperator, "СМС-оповещение с кодом подтверждения")
Rel(deposits_service, queue_approved_deposits, "Подтвержденные заявки на депозиты")
Rel(queue_approved_deposits, abs_db, "Новые подтвержденные депозиты")
Rel(abs, abs_db, "Получение данных о депозитах")
Rel(abs_db, queue_data, "Справочные данные клиентов")
Rel(queue_data, internet_bank_db, "Справочные данные клиентов")

@enduml
